{
  "name": "smart_power_web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "check:regression": "node scripts/check-directory.mjs",
    "check:map-layers": "node scripts/check-map-layers.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "check:auth-session": "node scripts/check-auth-session.mjs",
    "check:monitoring": "node scripts/check-monitoring.mjs",
    "check:twin": "node scripts/check-twin.mjs",
    "check:alarms": "node scripts/check-alarms.mjs",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:scene-config": "node scripts/check-scene-configuration.mjs",
    "check:point-management": "node scripts/check-point-maintenance.mjs",
    "check:site-relations": "node scripts/check-site-relations.mjs",
    "verify": "run-s lint check:regression check:map-layers check:auth check:auth-session check:monitoring check:twin check:alarms check:dashboard check:assets check:scene-config check:point-management check:site-relations build",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "cesium": "^1.146.0",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
