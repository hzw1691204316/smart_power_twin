# 复制为.env.mysql.local并仅在本地填写；用python -m scripts.run_backend_mysql启动。
# 启动器强制MySQL，不修改原.env，也不执行SQL导入。
SPT_DATA_SOURCE=mysql
SPT_MYSQL_HOST=127.0.0.1
SPT_MYSQL_PORT=3306
SPT_MYSQL_DATABASE=smart_power_twin
# 这里是MySQL连接账号，不是网页mysql_admin；可换为有下述表权限的专用账号。
SPT_MYSQL_USER=root
SPT_MYSQL_PASSWORD=
# 本模块账号维护须启用写入；台账接口本身仍只读。
SPT_MYSQL_ALLOW_WRITES=true
# 至少32字符，首次配置自行生成；不要使用示例字符串，不要放进前端。
SPT_TOKEN_SECRET=
SPT_TOKEN_MINUTES=30
